---
import ScrollHijack from "../layouts/ScrollHijack.astro";
---

<ScrollHijack title="Test">
  <div class="tall-force-scroll"></div>
  <div id="background-cube-container" class="background-cube-container"></div>
  <div class="animationtimeline">stupid cube</div>
</ScrollHijack>
<script>
  import { BackgroundCube } from "../js/background-cube.ts";
  new BackgroundCube("background-cube-container");
</script>

<style>
  .tall-force-scroll {
    height: 1000vh;
    width: 100vw;
    /* opacity: 1; */
    position: absolute;
    /* background-color: red; */
  }

  .background-cube-container {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 95vw;
    height: 95vh;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
    background-color: transparent;
  }

  .lines {
    position: absolute;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .animationtimeline {
    position: fixed;
    top: 20vh;
    left: 20vw;
    animation-timeline: scroll(root);
    animation-name: test;
    animation-duration: 1s;
    animation-timing-function: ease-in-out;
  }

  @keyframes test {
    0% {
      transform: translateX(0);
    }
    10% {
      transform: translateX(60vw);
    }
    20% {
      transform: translateX(0);
    }
    30% {
      transform: translateX(60vw);
    }
    40% {
      transform: translateX(0);
    }
    50% {
      transform: translateX(60vw);
    }
    60% {
      transform: translateX(0);
    }
    70% {
      transform: translateX(60vw);
    }
    80% {
      transform: translateX(0);
    }
    90% {
      transform: translateX(60vw);
    }
    100% {
      transform: translateX(0);
    }
  }
</style>
