---
import HomeLayout from "../layouts/HomeLayout.astro";
import RedactedLine from "../components/RedactedLine.astro";

const lines = [
  {
    text: "Software Engineer, from Vancouver, living in the Bay Area.",
    delay: 0.2,
  },
  { text: "This is my personal website.", delay: 0.4 },
  { text: "Here's some more stuff about me.", delay: 0.6 },
];
---

<HomeLayout title="Home">
  <div class="hero">
    <h1>Jason Liu</h1>
    <div class="lines">
      {lines.map((l) => <RedactedLine text={l.text} delay={l.delay} />)}
    </div>
  </div>
</HomeLayout>

<style>
  .hero h1 {
    margin-bottom: 1.5rem;
  }

  .lines {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    align-items: flex-start;
  }
</style>
